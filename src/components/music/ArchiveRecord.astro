---
import type { CollectionEntry } from 'astro:content';

interface Props {
  album: CollectionEntry<'albums'>['data'];
  trackCount: number;
}

const { album, trackCount } = Astro.props;
---
<section class="section archive-record-section" aria-labelledby="archive-record-title">
  <div class="container booklet-split">
    <div class="section-head compact-section-head">
      <p class="kicker">Permanent record / End matter</p>
      <h2 id="archive-record-title" class="display-lg">Archive record</h2>
    </div>
    <dl class="archive-record">
      <div><dt>Record title</dt><dd>{album.title}</dd></div>
      <div><dt>Primary artist</dt><dd>{album.artist}</dd></div>
      <div><dt>Catalog number</dt><dd>{album.catalogNumber ?? 'Not filed'}</dd></div>
      <div><dt>Release date</dt><dd>{album.releaseDate}</dd></div>
      <div><dt>Category</dt><dd>{album.category}</dd></div>
      <div><dt>Genre filing</dt><dd>{album.genre}</dd></div>
      <div><dt>Track count</dt><dd>{String(trackCount).padStart(2, '0')}</dd></div>
      <div><dt>Related world</dt><dd>{album.relatedWorld ?? 'Not filed'}</dd></div>
      <div><dt>Related story</dt><dd>{album.relatedStory ?? 'Not filed'}</dd></div>
      <div><dt>Archive status</dt><dd>{album.featured ? 'Featured public record' : 'Public record'}</dd></div>
    </dl>
  </div>
</section>
