---
import type { CollectionEntry } from 'astro:content';

interface Props {
  tracks: CollectionEntry<'tracks'>[];
}

const { tracks } = Astro.props;
---
<section class="section" aria-labelledby="track-details-title">
  <div class="container">
    <div class="section-head">
      <p class="kicker">Track records / Open one at a time</p>
      <h2 id="track-details-title" class="display-lg">Track records</h2>
      <p class="body-copy">Open a record to review the verified public information currently filed for each track.</p>
    </div>

    <div class="track-details">
      {tracks.map((track) => (
        <details id={`track-${String(track.data.number).padStart(2, '0')}`} open={track.data.number === 1}>
          <summary>
            <span class="track-number">{String(track.data.number).padStart(2, '0')}</span>
            <span class="display-sm">{track.data.title}</span>
            <span class="track-duration">{track.data.duration}</span>
          </summary>
          <div class="track-detail-body">
            {track.data.lyrics && (
              <section aria-labelledby={`lyrics-${track.id}`}>
                <p class="kicker" id={`lyrics-${track.id}`}>Lyrics</p>
                <p class="track-lyrics">{track.data.lyrics}</p>
              </section>
            )}
            {track.data.commentary && (
              <section aria-labelledby={`commentary-${track.id}`}>
                <p class="kicker" id={`commentary-${track.id}`}>Commentary</p>
                <p class="body-copy">{track.data.commentary}</p>
              </section>
            )}
            {track.data.credits.length > 0 && (
              <section aria-label={`Credits for ${track.data.title}`}>
                <dl class="track-credits">
                  {track.data.credits.map((credit) => (
                    <div>
                      <dt>{credit.role}</dt>
                      <dd>{credit.name}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )}
            {!track.data.lyrics && !track.data.commentary && track.data.credits.length === 0 && (
              <p class="body-copy">Detailed credits and lyrics have not been filed.</p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const revealTrackFromHash = () => {
    if (!window.location.hash.startsWith('#track-')) return;

    const target = document.querySelector(window.location.hash);
    if (!(target instanceof HTMLDetailsElement)) return;

    target.open = true;
    requestAnimationFrame(() => {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  };

  document.querySelectorAll<HTMLAnchorElement>('.track-index a[href^="#track-"]').forEach((link) => {
    link.addEventListener('click', () => {
      requestAnimationFrame(revealTrackFromHash);
    });
  });

  window.addEventListener('hashchange', revealTrackFromHash);
  revealTrackFromHash();
</script>
