---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PlatformLinks from '../../components/music/PlatformLinks.astro';

const albums = await getCollection('albums');
type AlbumEntry = (typeof albums)[number];

const catalogValue = (album: AlbumEntry) => {
  const value = Number.parseInt(album.data.catalogNumber ?? '', 10);
  return Number.isNaN(value) ? Number.NEGATIVE_INFINITY : value;
};

const byCatalogNumber = (a: AlbumEntry, b: AlbumEntry) =>
  catalogValue(a) - catalogValue(b)
  || Date.parse(a.data.releaseDate) - Date.parse(b.data.releaseDate)
  || a.data.title.localeCompare(b.data.title);

const releases = [...albums].sort((a, b) => Date.parse(b.data.releaseDate) - Date.parse(a.data.releaseDate));
const catalogReleases = [...albums].sort(byCatalogNumber);
const featured = catalogReleases.at(-1);
const categories = [
  {
    name: 'SHINHWI ORIGINALS' as const,
    note: 'Independent artist records filed under SHINHWI. Their relation to Project UNAC may be atmospheric, autobiographical, or entirely separate.'
  },
  {
    name: 'PROJECT UNAC OST' as const,
    note: 'World-bound sound records connected to Project UNAC stories, places, motifs, and archive events.'
  }
];

const dateLabel = (releaseDate: string) => new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(new Date(`${releaseDate}T00:00:00`));
---
<BaseLayout title="Music Archive" description="The SHINHWI and Project UNAC digital album archive: releases, liner notes, lyrics, credits, and listening records.">
  <PageHero
    kicker="Digital booklet system / Catalog register"
    title="Music Archive / SHINHWI"
    lead="A chronological sound archive for SHINHWI Originals and Project UNAC OST releases. Each record opens as a digital CD booklet with liner notes, lyrics, credits, and selected images."
  />

  {featured && (
    <section class="section" aria-labelledby="featured-release-title">
      <div class="container">
        <div class="section-head">
          <p class="kicker">Featured release / Current file</p>
          <h2 id="featured-release-title" class="display-lg">Featured release</h2>
        </div>
        <article class="music-feature">
          <a class="music-feature-cover" href={`/music/${featured.data.slug}/`}>
            <img src={featured.data.cover} alt={`${featured.data.title} album cover`} width="1200" height="1200" />
          </a>
          <div class="music-feature-copy">
            <p class="meta">{featured.data.catalogNumber ?? 'PUBLIC RELEASE'} / {featured.data.year} / {featured.data.category}</p>
            <h3 class="display-xl">{featured.data.title}</h3>
            <p class="lead">{featured.data.description}</p>
            <p class="body-copy">{featured.data.genre}</p>
            <div class="button-row">
              <a class="button-primary" href={`/music/${featured.data.slug}/`}>Open digital booklet</a>
            </div>
            <PlatformLinks album={featured.data} />
          </div>
        </article>
      </div>
    </section>
  )}

  {categories.map((category) => {
    const categoryAlbums = catalogReleases.filter((album) => album.data.category === category.name);
    return (
      <section class="section music-catalog-section" aria-labelledby={category.name.toLowerCase().replaceAll(' ', '-')}>
        <div class="container editorial-grid music-category-grid">
          <div class="section-head compact-section-head">
            <p class="kicker">Catalog division</p>
            <h2 id={category.name.toLowerCase().replaceAll(' ', '-')} class="display-lg">{category.name}</h2>
            <p class="body-copy">{category.note}</p>
            <p class="caption">{String(categoryAlbums.length).padStart(2, '0')} public records</p>
          </div>
          <div class="release-register">
            {categoryAlbums.length > 0 ? categoryAlbums.map((album) => (
              <article class="release-row">
                <a class="release-row-image" href={`/music/${album.data.slug}/`}>
                  <img src={album.data.cover} alt="" width="1200" height="1200" loading="lazy" />
                </a>
                <div class="release-row-copy">
                  <p class="meta">{album.data.catalogNumber ?? 'PUBLIC RELEASE'} / {dateLabel(album.data.releaseDate)}</p>
                  <h3 class="display-md"><a href={`/music/${album.data.slug}/`}>{album.data.title}</a></h3>
                  <p class="body-copy">{album.data.description}</p>
                  <a class="archive-open-link" href={`/music/${album.data.slug}/`}>Open booklet <span aria-hidden="true">→</span></a>
                </div>
              </article>
            )) : (
              <p class="archive-empty">No public album record has been filed in this division.</p>
            )}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section" aria-labelledby="discography-index-title">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Chronology / Complete public register</p>
        <h2 id="discography-index-title" class="display-lg">Discography index</h2>
      </div>
      <ol class="discography-index">
        {releases.map((album, index) => (
          <li>
            <a href={`/music/${album.data.slug}/`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>{album.data.year}</span>
              <span class="discography-title">{album.data.title}</span>
              <span>{album.data.category}</span>
              <span>{album.data.catalogNumber ?? 'PUBLIC RELEASE'}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section latest-transmission" aria-labelledby="music-transmission-title">
    <div class="container latest-transmission-grid">
      <div class="section-head latest-transmission-head">
        <p class="kicker">Latest transmission / Featured MV</p>
        <h2 id="music-transmission-title" class="display-lg">Latest transmission</h2>
        <p class="body-copy">One moving-image record is foregrounded here. The index remains an editorial archive rather than a wall of players.</p>
        <p class="caption">SHINHWI / Current video record</p>
      </div>
      <div class="mv-embed" aria-label="Featured SHINHWI music video">
        <iframe
          src="https://www.youtube-nocookie.com/embed/peH_uC9621o"
          title="LATEST MV / SHINHWI TRANSMISSION"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen>
        </iframe>
      </div>
    </div>
  </section>
</BaseLayout>
